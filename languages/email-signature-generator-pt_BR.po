msgid "Generate signature"
msgstr "Gerar assinatura"

#: src/config.php:269
msgid "Copy HTML"
msgstr "Copiar HTML"

#: src/config.php:270
msgid "Download image"
msgstr "Baixar imagem"

#: src/config.php:271
msgid "Preview"
msgstr "Pré-visualização"

#: src/config.php:272
msgid "Tel.:"
msgstr "Tel.:"

#: src/config.php:273
msgid "Signature copied. Paste it into your email signature settings."
msgstr "Assinatura copiada. Cole-a nas configurações de assinatura do seu e-mail."

#: src/config.php:274
msgid "The signature could not be copied. Select it in the preview and copy it by hand."
msgstr "Não foi possível copiar a assinatura. Selecione-a na pré-visualização e copie manualmente."

#: src/config.php:275
msgid "The image could not be created. Try again."
msgstr "Não foi possível gerar a imagem. Tente novamente."

#: src/config.php:276
msgid "More options"
msgstr "Mais opções"

#: src/config.php:277
msgid "Image downloaded. Links in an image cannot be clicked and small text loses sharpness: if your email program accepts it, prefer Copy HTML."
msgstr "Imagem baixada. Na imagem, os links não são clicáveis e o texto pequeno perde nitidez: se o seu programa de e-mail aceitar, prefira Copiar HTML."

#: src/config.php:278
msgid "Recommended: copy the HTML and paste it into your email program's signature settings. The text stays sharp at any size and the links work. Use the image only where a signature cannot be HTML."
msgstr "Recomendado: copie o HTML e cole nas configurações de assinatura do seu programa de e-mail. O texto fica nítido em qualquer tamanho e os links funcionam. Use a imagem apenas onde a assinatura não puder ser em HTML."

#. translators: %s: a field's label.
#: src/config.php:280
#, php-format
msgid "%s is required."
msgstr "O campo \"%s\" é obrigatório."

#: src/config.php:281
msgid "Enter a valid email address."
msgstr "Informe um e-mail válido."

#. translators: %s: an email domain, such as example.org.
#: src/config.php:283
#, php-format
msgid "Use an address at %s."
msgstr "Use um endereço do domínio %s."

#: src/config.php:284
msgid "Enter the phone number as 55 XX XXXX-XXXX or 55 XX XXXXX-XXXX. For two numbers, separate them with \" | \"."
msgstr "Informe o telefone no formato 55 XX XXXX-XXXX ou 55 XX XXXXX-XXXX. Para dois números, separe-os com \" | \"."

#. translators: %s: a field's label.
#: src/config.php:286
#, php-format
msgid "%s is not a valid address."
msgstr "O campo \"%s\" não é um endereço válido."

#. translators: %s: a field's label.
#: src/config.php:288
#, php-format
msgid "%s cannot contain a slash: the regional office's acronym is added on its own."
msgstr "O campo %s não pode ter barra: a sigla da diretoria é acrescentada sozinha."

#: src/config.php:289
msgid "Role takes a single role, without slashes."
msgstr "O campo \"Cargo\" aceita um único cargo, sem barras."

#. translators: %s: the offices left out, separated by commas.
#: src/settings.php:168
#, php-format
msgid "These regional offices were not saved, because each needs a name and a unique acronym of capitals and digits: %s"
msgstr "Estas diretorias não foram salvas, porque cada uma precisa de nome e de uma sigla única, com letras maiúsculas e números: %s"

#: src/shortcode.php:59
msgid "Log in to create your email signature."
msgstr "Faça login para criar sua assinatura de e-mail."

#: src/shortcode.php:61
msgid "Log in"
msgstr "Fazer login"

#: src/update/github-updater.php:197
msgid "Update package integrity check (SHA-256) failed. Installation aborted."
msgstr "A verificação de integridade (SHA-256) do pacote de atualização falhou. Instalação cancelada."

#. Plugin header: Description
msgid "A form, placed with a shortcode, that builds a consistent HTML email signature for your organisation and copies it to Outlook or downloads it as an image."
msgstr "Um formulário, inserido por shortcode, que monta uma assinatura de e-mail em HTML padronizada para a sua organização e a copia para o Outlook ou a baixa como imagem."

