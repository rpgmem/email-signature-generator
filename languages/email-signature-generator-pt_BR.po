#. translators: %1$s: number of the screenshot shown, %2$s: number of screenshots
#: src/update/screenshot-viewer.php:63
#, php-format
msgid "%1$s of %2$s"
msgstr "%1$s de %2$s"

#. Plugin header: Description
msgid "A form, placed with a shortcode, that builds a consistent HTML email signature for your organisation and copies it to Outlook or downloads it as an image."
msgstr "Um formulário, inserido por shortcode, que monta uma assinatura de e-mail em HTML padronizada para a sua organização e a copia para o Outlook ou a baixa como imagem."

#~ msgid "The site theme's, as in Free Form Certificate's forms, or the form's own (Arial)."
#~ msgstr "A do tema do site, como nos formulários do Free Form Certificate, ou a própria do formulário (Arial)."

#~ msgid "The form's own (Arial)"
#~ msgstr "A do formulário (Arial)"

#~ msgid "The on/off switches save as soon as they are flipped. Everything else saves with \"Save Changes\"."
#~ msgstr "As chaves liga/desliga salvam assim que são acionadas. O restante salva com \"Salvar alterações\"."

#~ msgid "Contents"
#~ msgstr "Sumário"

#~ msgid "Kept only in that browser, never sent to the site, and the form offers a link to forget it. Leave it off for shared computers."
#~ msgstr "Fica só naquele navegador, nunca é enviado ao site, e o formulário oferece um link para esquecer. Deixe desligado em computadores compartilhados."

#~ msgid "This browser remembers what you type here, for the next time. Nothing is sent to the site."
#~ msgstr "Este navegador lembra o que você digitar aqui, para a próxima vez. Nada é enviado ao site."

#~ msgid "Name in the form"
#~ msgstr "Nome no formulário"

#~ msgid "What the signature form calls the unit it asks for. Leave it empty to use the default shown."
#~ msgstr "Como o formulário de assinatura chama a unidade que pede. Deixe vazio para usar o padrão exibido."

#~ msgid "A default pre-fills the field. A locked field shows its default and cannot be changed, for a value every signature must share, such as the address of the building. The name and the email cannot be locked. Capitals prints the field in capital letters, however it was typed."
#~ msgstr "Um padrão preenche o campo de antemão. Um campo travado mostra o padrão e não pode ser alterado, para um valor que toda assinatura deve compartilhar, como o endereço do prédio. O nome e o e-mail não podem ser travados. Maiúsculas imprime o campo em letras maiúsculas, independentemente de como foi digitado."

#~ msgid "Name and email"
#~ msgstr "Nome e e-mail"

#~ msgid "Name in capitals"
#~ msgstr "Nome em maiúsculas"

#~ msgid "The name appears in capital letters, however it was typed"
#~ msgstr "O nome aparece em letras maiúsculas independentemente de como foi digitado"

#~ msgid "A default pre-fills the field. A locked field shows its default and cannot be changed, for a value every signature must share, such as the address of the building. The name and the email cannot be locked."
#~ msgstr "Um valor padrão preenche o campo. Um campo travado mostra o valor padrão e não pode ser alterado, para um valor que toda assinatura deve compartilhar, como o endereço do prédio. O nome e o e-mail não podem ser travados."

#~ msgid "Print the name in capital letters, whatever was typed"
#~ msgstr "Imprimir o nome em letras maiúsculas, como quer que tenha sido digitado"

#, php-format
#~ msgid "Place the form on any page with %s. These settings apply to every form on the site."
#~ msgstr "Coloque o formulário em qualquer página com %s. Estas configurações valem para todos os formulários do site."

#~ msgid "Only addresses at this domain are accepted. Leave it empty to accept any address."
#~ msgstr "Só são aceitos endereços deste domínio. Deixe vazio para aceitar qualquer endereço."

#~ msgid "Regional offices"
#~ msgstr "Diretorias Regionais"

#~ msgid "The choices of the \"Regional office or central\" field. The signature prints each as \"Name / ACRONYM\". The acronym identifies the office: capitals and digits, up to 12, each used once."
#~ msgstr "As opções do campo \"Regional ou Central\". A assinatura imprime cada uma como \"Nome / SIGLA\". A sigla identifica a diretoria: letras maiúsculas e números, até 12, sem repetir."

#~ msgid "Add an office"
#~ msgstr "Adicionar diretoria"

#~ msgid "Remove this office"
#~ msgstr "Remover esta diretoria"

#, php-format
#~ msgid "%s cannot contain a slash: the regional office's acronym is added on its own."
#~ msgstr "O campo %s não pode ter barra: a sigla da diretoria é acrescentada sozinha."

#, php-format
#~ msgid "These regional offices were not saved, because each needs a name and a unique acronym of capitals and digits: %s"
#~ msgstr "Estas diretorias não foram salvas, porque cada uma precisa de nome e de uma sigla única, com letras maiúsculas e números: %s"

#~ msgid "The name is always required."
#~ msgstr "O nome é sempre obrigatório."

#~ msgid "Role / Department"
#~ msgstr "Cargo / Setor"

#~ msgid "School / Regional office"
#~ msgstr "Escola / DRE"

#~ msgid "Role / Department needs text on both sides of the slash, or a single word without spaces."
#~ msgstr "O campo \"Cargo / Setor\" precisa de texto antes e depois da barra, ou de uma única palavra sem espaços."

#~ msgid "The choices of the \"Regional office or central\" field, one per line, exactly as the signature prints them."
#~ msgstr "As opções do campo \"Regional ou Central\", uma por linha, exatamente como a assinatura as imprime."

#~ msgid "Higher keeps the text sharper and makes the file larger. 90 suits most signatures."
#~ msgstr "Quanto maior, mais nítido o texto e maior o arquivo. 90 atende à maioria das assinaturas."

#~ msgid "Every visitor gets the same image, whatever their screen. 2× stays sharp on high-density screens."
#~ msgstr "Todos recebem a mesma imagem, seja qual for a tela. 2× continua nítido em telas de alta densidade."
