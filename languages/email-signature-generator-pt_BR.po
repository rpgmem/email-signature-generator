#: src/config.php:385
msgid "Signature copied. Paste it into your email signature settings."
msgstr "Assinatura copiada. Cole-a nas configurações de assinatura do seu e-mail."

#: src/config.php:386
msgid "The signature could not be copied. Select it in the preview and copy it by hand."
msgstr "Não foi possível copiar a assinatura. Selecione-a na pré-visualização e copie manualmente."

#: src/config.php:387
msgid "The image could not be created. Try again."
msgstr "Não foi possível gerar a imagem. Tente novamente."

#: src/config.php:388
msgid "More options"
msgstr "Mais opções"

#: src/config.php:389
msgid "Image downloaded. Links in an image cannot be clicked and small text loses sharpness: if your email program accepts it, prefer Copy HTML."
msgstr "Imagem baixada. Na imagem, os links não são clicáveis e o texto pequeno perde nitidez: se o seu programa de e-mail aceitar, prefira Copiar HTML."

#: src/config.php:390
msgid "Recommended: copy the HTML and paste it into your email program's signature settings. The text stays sharp at any size and the links work. Use the image only where a signature cannot be HTML."
msgstr "Recomendado: copie o HTML e cole nas configurações de assinatura do seu programa de e-mail. O texto fica nítido em qualquer tamanho e os links funcionam. Use a imagem apenas onde a assinatura não puder ser em HTML."

#. translators: %d: minutes.
#: src/config.php:393
#, php-format
msgid "This browser remembers what you type here for %d minutes after you generate the signature. Nothing is sent to the site."
msgstr "Este navegador lembra o que você digitar aqui por %d minutos depois de gerar a assinatura. Nada é enviado ao site."

#: src/config.php:396
msgid "Forget it"
msgstr "Esquecer"

#: src/config.php:397
msgid "The signature is built in your browser: nothing you type is sent to the site."
msgstr "A assinatura é gerada no seu navegador: nada do que você digita é enviado ao site."

#: src/config.php:398
msgid "Check the marked fields."
msgstr "Verifique os campos marcados."

#: src/config.php:399
msgid "This browser no longer keeps what you typed."
msgstr "Este navegador não guarda mais o que você digitou."

#: src/config.php:402
msgid "Outlook on the web and the new Outlook for Windows: Settings (gear) → Account → Signatures. Create a signature, paste with Ctrl+V, choose it for new messages and replies, and save."
msgstr "Outlook na web e novo Outlook para Windows: Configurações (engrenagem) → Conta → Assinaturas. Crie uma assinatura, cole com Ctrl+V, escolha-a para novas mensagens e respostas e salve."

#: src/config.php:403
msgid "Classic Outlook for Windows: File → Options → Mail → Signatures → New. Paste with Ctrl+V, choose it for new messages and replies, and select OK."
msgstr "Outlook clássico para Windows: Arquivo → Opções → Email → Assinaturas → Novo. Cole com Ctrl+V, escolha-a para novas mensagens e respostas e clique em OK."

#: src/config.php:404
msgid "Gmail: Settings (gear) → See all settings → General → Signature → Create new. Paste with Ctrl+V, choose it in \"Signature defaults\", and select \"Save changes\" at the bottom of the page."
msgstr "Gmail: Configurações (engrenagem) → Ver todas as configurações → Geral → Assinatura → Criar nova. Cole com Ctrl+V, escolha-a em \"Padrões de assinatura\" e clique em \"Salvar alterações\" no fim da página."

#: src/config.php:405
msgid "Phone apps: most accept only plain text. Set the signature on the web or on the computer; messages sent from there carry it."
msgstr "Aplicativos de celular: a maioria aceita só texto simples. Configure a assinatura na web ou no computador; as mensagens enviadas de lá a levam."

