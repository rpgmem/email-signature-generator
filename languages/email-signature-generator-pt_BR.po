#: src/config.php:313
msgid "Signature copied. Paste it into your email signature settings."
msgstr "Assinatura copiada. Cole-a nas configurações de assinatura do seu e-mail."

#: src/config.php:314
msgid "The signature could not be copied. Select it in the preview and copy it by hand."
msgstr "Não foi possível copiar a assinatura. Selecione-a na pré-visualização e copie manualmente."

#: src/config.php:315
msgid "The image could not be created. Try again."
msgstr "Não foi possível gerar a imagem. Tente novamente."

#: src/config.php:316
msgid "More options"
msgstr "Mais opções"

#: src/config.php:317
msgid "Image downloaded. Links in an image cannot be clicked and small text loses sharpness: if your email program accepts it, prefer Copy HTML."
msgstr "Imagem baixada. Na imagem, os links não são clicáveis e o texto pequeno perde nitidez: se o seu programa de e-mail aceitar, prefira Copiar HTML."

#: src/config.php:318
msgid "Recommended: copy the HTML and paste it into your email program's signature settings. The text stays sharp at any size and the links work. Use the image only where a signature cannot be HTML."
msgstr "Recomendado: copie o HTML e cole nas configurações de assinatura do seu programa de e-mail. O texto fica nítido em qualquer tamanho e os links funcionam. Use a imagem apenas onde a assinatura não puder ser em HTML."

