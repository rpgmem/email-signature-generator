#: src/config.php:422
msgid "How to add the signature in Outlook"
msgstr "Como adicionar a assinatura no Outlook"

#: src/config.php:423
msgid "How to add the signature in Gmail"
msgstr "Como adicionar a assinatura no Gmail"

#: src/config.php:424
msgid "Outlook on the web"
msgstr "Outlook na web"

#: src/config.php:425
msgid "Sign in at outlook.office.com, open Settings (the gear icon) and go to Account → Signatures."
msgstr "Entre em outlook.office.com, abra as Configurações (o ícone de engrenagem) e vá em Conta → Assinaturas."

#: src/config.php:426
msgid "The new Outlook for Windows"
msgstr "Novo Outlook para Windows"

#: src/config.php:427
msgid "In the app, open Settings (the gear icon) and go to Account → Signatures."
msgstr "No aplicativo, abra as Configurações (o ícone de engrenagem) e vá em Conta → Assinaturas."

#: src/config.php:428
msgid "Create a new signature, give it a name, and paste the signature into the box with Ctrl+V (Cmd+V on a Mac)."
msgstr "Crie uma nova assinatura, dê um nome a ela e cole a assinatura na caixa com Ctrl+V (Cmd+V no Mac)."

#: src/config.php:429
msgid "Choose it as the default signature for new messages and for replies and forwards, then save."
msgstr "Escolha-a como assinatura padrão para novas mensagens e para respostas e encaminhamentos, e salve."

#: src/config.php:430
msgid "Classic Outlook for Windows"
msgstr "Outlook clássico para Windows"

#: src/config.php:431
msgid "Go to File → Options → Mail → Signatures."
msgstr "Vá em Arquivo → Opções → Email → Assinaturas."

#: src/config.php:432
msgid "Create a new signature, give it a name, and paste the signature into the edit box with Ctrl+V."
msgstr "Crie uma nova assinatura, dê um nome a ela e cole a assinatura na caixa de edição com Ctrl+V."

#: src/config.php:433
msgid "Under the default signature choices, pick it for new messages and for replies and forwards, then confirm with OK."
msgstr "Na escolha da assinatura padrão, selecione-a para novas mensagens e para respostas e encaminhamentos, e confirme com OK."

#: src/config.php:434
msgid "In Gmail on the web, open Settings (the gear icon) → See all settings."
msgstr "No Gmail na web, abra as Configurações (o ícone de engrenagem) → Ver todas as configurações."

#: src/config.php:435
msgid "On the General tab, go to Signature and create a new one, giving it a name."
msgstr "Na guia Geral, vá até Assinatura e crie uma nova, dando um nome a ela."

#: src/config.php:436
msgid "Paste the signature into the box with Ctrl+V (Cmd+V on a Mac)."
msgstr "Cole a assinatura na caixa com Ctrl+V (Cmd+V no Mac)."

#: src/config.php:437
msgid "Under the signature defaults, choose it for new emails and for replies and forwards."
msgstr "Nos padrões de assinatura, escolha-a para novos e-mails e para respostas e encaminhamentos."

#: src/config.php:438
msgid "Save the changes at the bottom of the page."
msgstr "Salve as alterações no fim da página."

#: src/config.php:439
msgid "Phone apps: most accept only plain text. Set the signature on the web or on the computer; messages sent from there carry it."
msgstr "Aplicativos de celular: a maioria aceita só texto simples. Configure a assinatura na web ou no computador; as mensagens enviadas de lá a levam."

#. translators: %s: a field's label.
#: src/config.php:441
#, php-format
