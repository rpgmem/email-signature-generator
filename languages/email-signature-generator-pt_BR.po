#: src/config.php:257
msgid "Signature copied. Paste it into your email signature settings."
msgstr "Assinatura copiada. Cole-a nas configurações de assinatura do seu e-mail."

#: src/config.php:258
msgid "The signature could not be copied. Select it in the preview and copy it by hand."
msgstr "Não foi possível copiar a assinatura. Selecione-a na pré-visualização e copie manualmente."

#: src/config.php:259
msgid "The image could not be created. Try again."
msgstr "Não foi possível gerar a imagem. Tente novamente."

#. translators: %s: a field's label.
#: src/config.php:261
#, php-format
msgid "%s is required."
msgstr "O campo \"%s\" é obrigatório."

#: src/config.php:262
msgid "Enter a valid email address."
msgstr "Informe um e-mail válido."

#. translators: %s: an email domain, such as example.org.
#: src/config.php:264
#, php-format
msgid "Use an address at %s."
msgstr "Use um endereço do domínio %s."

#: src/config.php:265
msgid "Enter the phone number as 55 XX XXXX-XXXX or 55 XX XXXXX-XXXX. For two numbers, separate them with \" | \"."
msgstr "Informe o telefone no formato 55 XX XXXX-XXXX ou 55 XX XXXXX-XXXX. Para dois números, separe-os com \" | \"."

#. translators: %s: a field's label.
#: src/config.php:267
#, php-format
msgid "%s is not a valid address."
msgstr "O campo \"%s\" não é um endereço válido."

#: src/config.php:268
msgid "Role / Department needs text on both sides of the slash, or a single word without spaces."
msgstr "O campo \"Cargo / Setor\" precisa de texto antes e depois da barra, ou de uma única palavra sem espaços."

#: src/config.php:269
msgid "Role takes a single role, without slashes."
msgstr "O campo \"Cargo\" aceita um único cargo, sem barras."

